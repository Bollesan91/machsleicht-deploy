@@ -53,7 +55,7 @@ for pfad in sorted(glob.glob('kindergeburtstag/*.html')):
     for wort, umfeld in treffer_in(t):
         fails.append('%s: %s (%r)' % (pfad, wort, umfeld[:80]))
 
