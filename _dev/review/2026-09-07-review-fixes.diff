+const TECHNISCHE_COMMITS = ['74ea116d'];
 function getLastmod(filePath) {
   if (_lastmodCache[filePath] !== undefined) return _lastmodCache[filePath];
   let d = TODAY; // Fallback: neue/ungetrackte Datei
   try {
