+            r'([(=,\[!&|:;?]\s*)/(?![/*])(?:\\.|\[(?:\\.|[^\]])*\]|[^/\n\\])+/[gimsuy]*',
+            r'\1 ', koerper)
         benutzt = set(WORT.findall(koerper))
         # Alles, was IN DIESER Funktion gebunden wird, ist kein Leck. Ohne das
         # meldete die erste Fassung 60 Fehlalarme: kurze Namen wie s, sub, grp
