+        # Whitelist-Eintrag muss im Umfeld stehen UND den Treffer selbst enthalten —
+        # sonst entschuldigt "Prinzessin Lina" jedes andere Kind im selben Satz.
+        if any(w in umfeld and wort in w for w in WHITELIST):
